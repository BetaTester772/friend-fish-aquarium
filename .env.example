# Copy to .env before `docker compose up`. .env is gitignored: this repository
# is public, and an address committed to it gets scraped.

# The hostname you are serving. Must already resolve to this host.
FFA_DOMAIN=friend-fish-aquarium.betatester772.dev

# Where Let's Encrypt sends certificate-expiry warnings. Required — Caddy
# refuses to start with an empty one.
FFA_EMAIL=you@example.com
