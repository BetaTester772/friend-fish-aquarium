{
  "name": "friend-fish-aquarium",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shared 3D aquarium where friends add themselves as face-fish and feed each other like tamagotchis.",
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/node.js",
    "dev:client": "vite",
    "prebuild": "node scripts/copy-wasm.js",
    "build": "vite build",
    "start": "node server/node.js",
    "seed": "node scripts/seed.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "postinstall": "node scripts/copy-wasm.js"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.18",
    "better-sqlite3": "^11.5.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "vite": "^5.4.11"
  }
}
